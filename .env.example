# PostgreSQL connection string. Use Render's internal database URL in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teranga_gp?schema=public"
# Public URL used by authentication links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
# Generate a private random secret for production; do not commit it.
BETTER_AUTH_SECRET=""
# SMTP credentials for account verification and password reset emails.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Configure only on the server; OpenAI usage can incur charges.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
AI_ASSISTANT_ENABLED="false"
# No payment or identity-verification provider is configured.
